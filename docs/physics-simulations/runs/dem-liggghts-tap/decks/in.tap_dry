atom_style      granular
atom_modify     map array
boundary        p p f
newton          off
communicate     single vel yes
units           si
soft_particles  yes
region          domain block 0.000000e+00 5.100000e-03 0.000000e+00 5.100000e-03 -5.000000e-04 3.000000e-02 units box
create_box      2 domain
neighbor        2.1250e-04 bin
neigh_modify    delay 0

fix m1 all property/global youngsModulus peratomtype 2.0000e+05 2.0000e+05
fix m2 all property/global poissonsRatio peratomtype 0.3 0.3
fix m3 all property/global coefficientRestitution peratomtypepair 2 0.5 0.5 0.5 0.5
fix m4 all property/global coefficientFriction peratomtypepair 2 0.5 0.4 0.4 0.4
fix m5 all property/global coefficientRollingFriction peratomtypepair 2 0.3 0.3 0.3 0.3

pair_style gran model hertz tangential history  rolling_friction epsd2
pair_coeff * *
timestep 2.0557e-05
fix gravi all gravity 9.81 vector 0.0 0.0 -1.0

fix pts1 all particletemplate/sphere 15485863 atom_type 1 density constant 2165.0 radius constant 1.805000e-04
fix pts2 all particletemplate/sphere 15485867 atom_type 1 density constant 2165.0 radius constant 2.125000e-04
fix pts3 all particletemplate/sphere 32452843 atom_type 1 density constant 2165.0 radius constant 2.445000e-04
fix pdd  all particledistribution/discrete/numberbased 49979687 3 pts1 0.3 pts2 0.4 pts3 0.3

fix floor all wall/gran model hertz tangential history  rolling_friction epsd2 primitive type 2 zplane 0.0
region pour block 0. 5.100000e-03 0. 5.100000e-03 0.3e-3 16.3e-3 units box
fix ins all insert/pack seed 86028157 distributiontemplate pdd insert_every once overlapcheck yes all_in yes particles_in_region 2500 region pour ntry_mc 20000
fix integr all nve/sphere
variable t equal time
variable n equal atoms
variable zt equal bound(all,zmax)
variable ke equal ke
thermo_style custom step time atoms ke
thermo 2432
thermo_modify lost ignore norm no flush yes
fix logz all print 97 "${t} ${n} ${zt} ${ke}" file ztop.txt screen no
# --- pour (apparent density)
run 13134
unfix ins
run 3892
write_dump all custom dump/poured.txt id type radius x y z vx vy vz
dump dmp all custom 486 dump/p.*.txt id type radius x y z vx vy vz
dump_modify dmp first yes
# --- taps
label tap
variable i loop 30
  displace_atoms all move 0.0 0.0 3.0000e-03 units box
  run 3635
  write_dump all custom dump/tap_${i}.txt id type radius x y z vx vy vz
next i
jump SELF tap
