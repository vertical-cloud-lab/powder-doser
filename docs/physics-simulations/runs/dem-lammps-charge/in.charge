# LAMMPS GRANULAR + coul/cut: charged salt grains poured beside a charged (tribocharged PLA-like) wall.
# Mobile grains: 3 sizes of "table salt" spheres, Hertz-Mindlin + SDS rolling friction (no cohesion).
# Wall at x = 0: one square layer of frozen spheres (spacing a = 0.425 mm) carrying a uniform
# surface charge density sigw. Floor and far side wall: smooth granular walls (uncharged).
# Usage: lmp -in in.charge -var qm -1e-5 -var sigw 1e-5 -var tag B -var out /tmp/dir [-var nrun 20000]
#   qm   = particle charge-to-mass ratio (C/kg), same sign for every grain (unipolar tribocharging)
#   sigw = wall surface charge density (C/m^2)
units           si
atom_style      hybrid sphere charge
dimension       3
boundary        f p f
newton          off
comm_modify     vel yes

variable        rho   equal 2165
variable        a     equal 0.425e-3
variable        Lx    equal 10*${a}
variable        Ly    equal 10*${a}
variable        Lz    equal 0.020
variable        rc    equal 1.2e-3
region          box block -0.3e-3 ${Lx} 0 ${Ly} 0 ${Lz} units box
create_box      4 box

# frozen wall layer at x = 0 (type 4)
lattice         sc ${a}
region          wallreg block -0.1e-3 0.1e-3 0 ${Ly} 0.2e-3 0.0128 units box
create_atoms    4 region wallreg
group           wall type 4
set             group wall diameter ${a}
set             group wall density ${rho}

# mobile grains (types 1-3, 0.361/0.425/0.489 mm in number fractions 0.3/0.4/0.3), inserted loose above
region          ins block 0.5e-3 3.95e-3 0 ${Ly} 4.0e-3 0.0185 units box
create_atoms    1 random 240 4821 ins overlap 0.5e-3 maxtry 500
create_atoms    2 random 320 9173 ins overlap 0.5e-3 maxtry 500
create_atoms    3 random 240 2267 ins overlap 0.5e-3 maxtry 500
group           mobile type 1 2 3
set             type 1 diameter 0.361e-3
set             type 2 diameter 0.425e-3
set             type 3 diameter 0.489e-3
set             group mobile density ${rho}

# charges: q_i = (q/m) * m_i ; wall: q_w = sigw * a^2 per wall sphere
variable        m1 equal ${rho}*PI/6*(0.361e-3)^3
variable        m2 equal ${rho}*PI/6*(0.425e-3)^3
variable        m3 equal ${rho}*PI/6*(0.489e-3)^3
variable        q1 equal ${qm}*${m1}
variable        q2 equal ${qm}*${m2}
variable        q3 equal ${qm}*${m3}
variable        qw equal ${sigw}*${a}*${a}
set             type 1 charge ${q1}
set             type 2 charge ${q2}
set             type 3 charge ${q3}
set             type 4 charge ${qw}

pair_style      hybrid/overlay granular coul/cut ${rc}
pair_coeff      * * granular hertz/material 2.0e5 0.5 0.3 tangential mindlin NULL 1.0 0.5 rolling sds 1.0 0.0 0.3 twisting marshall damping tsuji
pair_coeff      1*3 4 granular hertz/material 2.0e5 0.5 0.3 tangential mindlin NULL 1.0 0.4 rolling sds 1.0 0.0 0.3 twisting marshall damping tsuji
pair_coeff      * * coul/cut
dielectric      1.0
neighbor        0.2e-3 bin
neigh_modify    delay 0 every 1 check yes exclude type 4 4

timestep        1.0e-5
fix             integ mobile nve/sphere
fix             grav mobile gravity 9.81 vector 0 0 -1
fix             floor mobile wall/gran granular hertz/material 2.0e5 0.5 0.3 tangential mindlin NULL 1.0 0.4 rolling sds 1.0 0.0 0.3 twisting marshall damping tsuji zplane 0.0 NULL
fix             far   mobile wall/gran granular hertz/material 2.0e5 0.5 0.3 tangential mindlin NULL 1.0 0.4 rolling sds 1.0 0.0 0.3 twisting marshall damping tsuji xplane -0.25e-3 ${Lx}
fix             lid   mobile wall/gran granular hertz/material 2.0e5 0.5 0.3 tangential mindlin NULL 1.0 0.4 rolling sds 1.0 0.0 0.3 twisting marshall damping tsuji zplane NULL 0.0195

compute         kem mobile ke
compute         zmax mobile reduce max z
thermo_style    custom step time c_kem c_zmax ecoul
thermo          1000
thermo_modify   norm no flush yes lost ignore
dump            dmp all custom 400 ${out}/dump_${tag}.lammpstrj id type diameter q x y z vx vy vz
dump_modify     dmp sort id
variable        nrun index 20000
run             ${nrun}
write_dump      all custom ${out}/final_${tag}.lammpstrj id type diameter q x y z vx vy vz modify sort id
