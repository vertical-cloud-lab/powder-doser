atom_style      granular
atom_modify     map array
boundary        p p f
newton          off
communicate     single vel yes
units           si
soft_particles  yes
region          domain block 0.000000e+00 6.800000e-03 0.000000e+00 3.400000e-03 0.000000e+00 1.200000e-02 units box
create_box      2 domain
neighbor        2.1250e-04 bin
neigh_modify    delay 0

fix m1 all property/global youngsModulus peratomtype 2.0000e+05 2.0000e+05
fix m2 all property/global poissonsRatio peratomtype 0.3 0.3
fix m3 all property/global coefficientRestitution peratomtypepair 2 0.5 0.5 0.5 0.5
fix m4 all property/global coefficientFriction peratomtypepair 2 0.5 0.4 0.4 0.4
fix m5 all property/global coefficientRollingFriction peratomtypepair 2 0.3 0.3 0.3 0.3

pair_style gran model hertz tangential history  rolling_friction epsd2
pair_coeff * *
timestep 2.0557e-05

fix pts1 all particletemplate/sphere 15485863 atom_type 1 density constant 2165.0 radius constant 1.805000e-04
fix pts2 all particletemplate/sphere 15485867 atom_type 1 density constant 2165.0 radius constant 2.125000e-04
fix pts3 all particletemplate/sphere 32452843 atom_type 1 density constant 2165.0 radius constant 2.445000e-04
fix pdd  all particledistribution/discrete/numberbased 49979687 3 pts1 0.3 pts2 0.4 pts3 0.3

lattice sc 4.250000e-04 origin 0.5 0.5 0.5
region botlayer block 0. 6.800000e-03 0. 3.400000e-03 0. 4.250000e-04 units box
create_atoms 1 region botlayer
group bot region botlayer
region lidlayer block 0. 6.800000e-03 0. 3.400000e-03 1.020000e-02 1.062500e-02 units box
create_atoms 1 region lidlayer
group lid region lidlayer
set group bot diameter 4.250000e-04
set group bot density 2165.0
set group lid diameter 4.250000e-04
set group lid density 2165.0
region insreg block 0. 6.800000e-03 0. 3.400000e-03 0.7e-3 9.700000e-03 units box
group bulk region insreg
fix ins bulk insert/pack seed 86028157 distributiontemplate pdd insert_every once overlapcheck yes all_in yes particles_in_region 1800 region insreg ntry_mc 20000
fix integr bulk nve/sphere
fix gravi bulk gravity 9.81 vector 0.0 0.0 -1.0
fix lidmove lid move linear 0.0 0.0 0.0
compute fbot bot reduce sum fx fy fz
compute zlid lid reduce ave z
variable t equal time
variable tau equal c_fbot[1]/2.312000e-05
variable sig equal -c_fbot[3]/2.312000e-05
variable zl equal c_zlid
thermo_style custom step time atoms c_fbot[1] c_fbot[3] c_zlid
thermo 2432
thermo_modify lost ignore norm no flush yes
run 1
fix logs all print 49 "${t} ${tau} ${sig} ${zl}" file stress.txt screen no title "t tau sig zlid"
dump dmp all custom 486 dump/p.*.txt id type radius x y z vx vy vz
run 7297
unfix gravi
unfix lidmove
fix lidmove lid move linear 0.0 0.0 NULL
fix lidvisc lid viscous 0.0012
fix lidload lid aveforce NULL NULL -3.612500e-05
run 9729
unfix lidmove
fix lidmove lid move linear 0.01 0.0 NULL
run 12161
unfix lidmove
fix lidmove lid move linear 0.0 0.0 NULL
unfix lidload
fix lidload lid aveforce NULL NULL -9.031250e-06
run 1946
unfix lidmove
fix lidmove lid move linear 0.01 0.0 NULL
run 9729
unfix lidload
fix lidload lid aveforce NULL NULL -3.612500e-05
unfix lidmove
fix lidmove lid move linear 0.01 0.0 NULL
run 12161
unfix lidmove
fix lidmove lid move linear 0.0 0.0 NULL
unfix lidload
fix lidload lid aveforce NULL NULL -1.806250e-05
run 1946
unfix lidmove
fix lidmove lid move linear 0.01 0.0 NULL
run 9729
unfix lidload
fix lidload lid aveforce NULL NULL -3.612500e-05
unfix lidmove
fix lidmove lid move linear 0.01 0.0 NULL
run 12161
unfix lidmove
fix lidmove lid move linear 0.0 0.0 NULL
unfix lidload
fix lidload lid aveforce NULL NULL -2.709375e-05
run 1946
unfix lidmove
fix lidmove lid move linear 0.01 0.0 NULL
run 9729
unfix lidload
fix lidload lid aveforce NULL NULL -3.612500e-05
unfix lidmove
fix lidmove lid move linear 0.01 0.0 NULL
run 12161
