# auto-generated by sim/dem/run_case.py -- case micro_rig_d030
atom_style      granular
atom_modify     map array
boundary        f f f
newton          off
communicate     single vel yes
units           si
soft_particles  yes
processors      1 1 *
read_data       data.init
neighbor        1.500e-04 bin
neigh_modify    delay 0

fix m1 all property/global youngsModulus peratomtype 2.0000e+05 2.0000e+05
fix m2 all property/global poissonsRatio peratomtype 0.3 0.3
fix m3 all property/global coefficientRestitution peratomtypepair 2 0.5 0.5 0.5 0.5
fix m4 all property/global coefficientFriction peratomtypepair 2 0.5 0.4 0.4 0.4
fix m5 all property/global coefficientRollingFriction peratomtypepair 2 0.3 0.3 0.3 0.3

pair_style gran model hertz tangential history  rolling_friction epsd2
pair_coeff * *
timestep 1.4504e-05

fix gravi all gravity 9.81 vector -0.965926 0.000000 -0.258819
fix auger  all mesh/surface file auger.stl type 2 scale 0.001 curvature_tolerant yes
fix plug   all mesh/surface file plug.stl type 2 scale 0.001
fix outlet all mesh/surface/planar file outlet.stl type 2 scale 0.001
fix walls  all wall/gran model hertz tangential history  rolling_friction epsd2 mesh n_meshes 2 meshes auger plug

fix pts1 all particletemplate/sphere 15485863 atom_type 1 density constant 2160.0 radius constant 1.275000e-04
fix pts2 all particletemplate/sphere 15485867 atom_type 1 density constant 2160.0 radius constant 1.500000e-04
fix pts3 all particletemplate/sphere 32452843 atom_type 1 density constant 2160.0 radius constant 1.725000e-04
fix pdd  all particledistribution/discrete/numberbased 49979687 3 pts1 0.3 pts2 0.4 pts3 0.3

fix integr all nve/sphere
fix mf all massflow/mesh mesh outlet vec_side 0. 0. -1. count once delete_atoms yes
compute rke all erotate/sphere
variable t equal time
variable mout equal f_mf[1]
variable nout equal f_mf[2]
variable natoms equal atoms
thermo_style custom step time atoms f_mf[1] f_mf[2] ke c_rke
thermo 3447
thermo_modify lost ignore norm no flush yes
fix logmf all print 345 "${t} ${mout} ${nout} ${natoms}" file outflow.txt screen no

region feedcyl cylinder z 0. 0. 4.640000e-03 2.210000e-02 2.505000e-02 units box
region feedlow block -4.640000e-03 -1.500000e-03 -4.640000e-03 4.640000e-03 2.210000e-02 2.505000e-02 units box
region feedreg intersect 2 feedcyl feedlow
fix feed all insert/rate/region seed 86028157 distributiontemplate pdd nparticles INF particlerate 9481 insert_every 1379 overlapcheck yes all_in yes vel constant 0. 0. -0.05 region feedreg ntry_mc 2000


# --- settle with the exit plugged
run 8273
# --- open the exit and start the motor
unfix walls
fix walls2 all wall/gran model hertz tangential history  rolling_friction epsd2 mesh n_meshes 1 meshes auger
fix spin all move/mesh mesh auger rotate origin 0. 0. 0. axis 0. 0. 1. period 1.090909
print "PHASE rotate start t=${t}"
run 75213
unfix spin
print "PHASE stop t=${t}"
run 20683

print "PHASE done t=${t}"
